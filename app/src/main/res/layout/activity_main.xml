<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="12dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="8dp"
        android:textColor="@color/textPrimary"/>

    <!-- Effect selector -->
    <RadioGroup
        android:id="@+id/rgEffect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="12dp">

        <RadioButton android:id="@+id/rbCompressor"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Compressor" android:textSize="11sp" android:enabled="false"/>

        <RadioButton android:id="@+id/rbEqualizer"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Equalizer" android:textSize="11sp" android:checked="true"
            android:layout_marginStart="8dp"/>

        <RadioButton android:id="@+id/rbReverb"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Reverb" android:textSize="11sp" android:enabled="false"
            android:layout_marginStart="8dp"/>

        <RadioButton android:id="@+id/rbChorus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Chorus" android:textSize="11sp" android:enabled="false"
            android:layout_marginStart="8dp"/>
    </RadioGroup>

    <!-- Sliders area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Volume -->
        <LinearLayout android:layout_width="52dp" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center"
            android:clipChildren="false">
            <TextView android:id="@+id/labelVolume"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="100%" android:textSize="9sp" android:gravity="center"/>
            <FrameLayout android:layout_width="44dp" android:layout_height="180dp"
                android:clipChildren="false">
                <SeekBar android:id="@+id/seekVolume"
                    android:layout_width="180dp" android:layout_height="44dp"
                    android:layout_gravity="center" android:rotation="-90"
                    android:progressTint="@color/colorAccent"
                    android:progressBackgroundTint="@color/sliderTrack"
                    android:thumbTint="@color/white"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/label_volume" android:textSize="9sp" android:gravity="center"/>
        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="1dp" android:layout_height="match_parent"
            android:background="@color/sliderTrack" android:layout_marginHorizontal="4dp"/>

        <!-- Band 0 -->
        <LinearLayout android:id="@+id/col0"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:orientation="vertical"
            android:gravity="center" android:clipChildren="false">
            <TextView android:id="@+id/level0"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0dB" android:textSize="9sp" android:gravity="center"/>
            <FrameLayout android:layout_width="44dp" android:layout_height="160dp"
                android:clipChildren="false">
                <SeekBar android:id="@+id/band0"
                    android:layout_width="160dp" android:layout_height="44dp"
                    android:layout_gravity="center" android:rotation="-90"
                    android:progressTint="@color/colorAccent"
                    android:progressBackgroundTint="@color/sliderTrack"
                    android:thumbTint="@color/white"/>
            </FrameLayout>
            <TextView android:id="@+id/freq0"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="--" android:textSize="9sp" android:gravity="center"/>
        </LinearLayout>

        <!-- Band 1 -->
        <LinearLayout android:id="@+id/col1"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:orientation="vertical"
            android:gravity="center" android:clipChildren="false">
            <TextView android:id="@+id/level1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0dB" android:textSize="9sp" android:gravity="center"/>
            <FrameLayout android:layout_width="44dp" android:layout_height="160dp"
                android:clipChildren="false">
                <SeekBar android:id="@+id/band1"
                    android:layout_width="160dp" android:layout_height="44dp"
                    android:layout_gravity="center" android:rotation="-90"
                    android:progressTint="@color/colorAccent"
                    android:progressBackgroundTint="@color/sliderTrack"
                    android:thumbTint="@color/white"/>
            </FrameLayout>
            <TextView android:id="@+id/freq1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="--" android:textSize="9sp" android:gravity="center"/>
        </LinearLayout>

        <!-- Band 2 -->
        <LinearLayout android:id="@+id/col2"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:orientation="vertical"
            android:gravity="center" android:clipChildren="false">
            <TextView android:id="@+id/level2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0dB" android:textSize="9sp" android:gravity="center"/>
            <FrameLayout android:layout_width="44dp" android:layout_height="160dp"
                android:clipChildren="false">
                <SeekBar android:id="@+id/band2"
                    android:layout_width="160dp" android:layout_height="44dp"
                    android:layout_gravity="center" android:rotation="-90"
                    android:progressTint="@color/colorAccent"
                    android:progressBackgroundTint="@color/sliderTrack"
                    android:thumbTint="@color/white"/>
            </FrameLayout>
            <TextView android:id="@+id/freq2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="--" android:textSize="9sp" android:gravity="center"/>
        </LinearLayout>

        <!-- Band 3 -->
        <LinearLayout android:id="@+id/col3"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:orientation="vertical"
            android:gravity="center" android:clipChildren="false">
            <TextView android:id="@+id/level3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0dB" android:textSize="9sp" android:gravity="center"/>
            <FrameLayout android:layout_width="44dp" android:layout_height="160dp"
                android:clipChildren="false">
                <SeekBar android:id="@+id/band3"
                    android:layout_width="160dp" android:layout_height="44dp"
                    android:layout_gravity="center" android:rotation="-90"
                    android:progressTint="@color/colorAccent"
                    android:progressBackgroundTint="@color/sliderTrack"
                    android:thumbTint="@color/white"/>
            </FrameLayout>
            <TextView android:id="@+id/freq3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="--" android:textSize="9sp" android:gravity="center"/>
        </LinearLayout>

        <!-- Band 4 -->
        <LinearLayout android:id="@+id/col4"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:orientation="vertical"
            android:gravity="center" android:clipChildren="false">
            <TextView android:id="@+id/level4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0dB" android:textSize="9sp" android:gravity="center"/>
            <FrameLayout android:layout_width="44dp" android:layout_height="160dp"
                android:clipChildren="false">
                <SeekBar android:id="@+id/band4"
                    android:layout_width="160dp" android:layout_height="44dp"
                    android:layout_gravity="center" android:rotation="-90"
                    android:progressTint="@color/colorAccent"
                    android:progressBackgroundTint="@color/sliderTrack"
                    android:thumbTint="@color/white"/>
            </FrameLayout>
            <TextView android:id="@+id/freq4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="--" android:textSize="9sp" android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp">

        <Button android:id="@+id/btnOnOff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_off"
            android:backgroundTint="@color/colorAccent"
            android:textColor="@color/white"/>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <Spinner android:id="@+id/spinnerPreset"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:background="@color/surface"/>

        <Button android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_reset"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
